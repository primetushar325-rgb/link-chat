# ── Mobile (Expo) — prefix with EXPO_PUBLIC_ to expose to client ──
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4001
EXPO_PUBLIC_GOOGLE_CLIENT_ID= # same as GOOGLE_CLIENT_ID — Google Cloud Console > Credentials > OAuth 2.0 Client ID
# Get at: https://console.cloud.google.com/apis/credentials

# ── Backend (backend/.env) ──
PORT=4000
WS_PORT=4001
DATABASE_URL=file:./data/db.json
JWT_SECRET=replace_with_64_char_random_string_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_another_64_char_random
GOOGLE_CLIENT_ID= # Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web application) — same as EXPO_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET= # Google Cloud Console > Credentials > OAuth 2.0 Client > Client secret
CLOUDINARY_CLOUD_NAME=xku0l7uc # Cloudinary Console > Dashboard > Cloud name (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_API_KEY=725198571393975 # Cloudinary Console > API Keys > API Key
CLOUDINARY_API_SECRET=zDIczZZd_ySyVSXVQPvtQcLao7w # Cloudinary Console > API Keys > API Secret (click View)
CORS_ORIGIN=http://localhost:3000,http://localhost:19006,exp://*
EXPO_PUSH_ACCESS_TOKEN= # Optional: Expo push service token if using Expo push API with auth
ADMIN_SEED_EMAIL=admin@link.app
ADMIN_SEED_PASSWORD=Admin123!

# ── Admin (admin/.env.local) ──
NEXT_PUBLIC_API_URL=http://localhost:4000
ADMIN_JWT_SECRET=same_as_JWT_SECRET
